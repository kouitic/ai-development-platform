{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev/stage-result.schema.json",
  "title": "StageResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "summary", "evidence", "findings", "conditions",
    "evidence_complete", "required_tests_passed"
  ],
  "properties": {
    "decision": {"enum": ["PASS", "PASS_WITH_CONDITIONS", "REJECT", "INSUFFICIENT_EVIDENCE"]},
    "summary": {"type": "string"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "evidence_complete": {"type": "boolean"},
    "required_tests_passed": {"type": "boolean"},
    "run_id": {"type": "string", "minLength": 1},
    "resolved_finding_ids": {"type": "array", "items": {"type": "string"}},
    "finding_resolution_evidence": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reference"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "artifact", "github", "commit", "dataset", "metric", "mock"]},
        "reference": {"type": "string", "minLength": 1},
        "safe_summary": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "severity", "category", "requirement_ids", "problem", "evidence",
        "business_impact", "required_fix", "acceptance_test", "blocking"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
        "severity": {"enum": ["critical", "major", "minor", "suggestion"]},
        "category": {"type": "string", "minLength": 1},
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "problem": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "business_impact": {"type": "string", "minLength": 1},
        "required_fix": {"type": "string", "minLength": 1},
        "acceptance_test": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "recurrence": {"type": "boolean"},
        "origin_review_type": {"enum": ["SYSTEM", "BUSINESS", "QA", null]},
        "origin_review_run_id": {"type": "string"},
        "origin_commit_sha": {"type": "string"},
        "status": {"enum": ["OPEN", "FIX_CLAIMED", "VERIFICATION_REQUIRED", "RESOLVED", "REOPENED", "ACCEPTED_BY_HUMAN"]},
        "resolution_candidate_commit_sha": {"type": ["string", "null"]},
        "resolved_by_review_run_id": {"type": ["string", "null"]},
        "resolved_at_commit_sha": {"type": ["string", "null"]},
        "resolution_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "owner", "due_or_next_stage", "human_approval_required", "unmet_action"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "due_or_next_stage": {"type": "string", "minLength": 1},
        "human_approval_required": {"type": "boolean"},
        "unmet_action": {"enum": ["REWORK", "BLOCK", "REJECT"]},
        "resolved": {"type": "boolean"},
        "resolution_evidence": {"type": "array", "items": {"type": "string"}},
        "resolved_at_commit_sha": {"type": ["string", "null"]}
      }
    }
  }
}
