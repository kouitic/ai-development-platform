{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageResult",
  "type": "object",
  "required": ["decision", "summary", "evidence", "findings", "conditions", "evidence_complete", "required_tests_passed"],
  "properties": {
    "decision": {"enum": ["PASS", "PASS_WITH_CONDITIONS", "REJECT", "INSUFFICIENT_EVIDENCE"]},
    "summary": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "reference"]}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "category", "requirement_ids", "problem", "evidence", "business_impact", "required_fix", "acceptance_test", "blocking"]}},
    "conditions": {"type": "array", "items": {"type": "object", "required": ["condition", "owner", "due_or_next_stage", "human_approval_required", "unmet_action"]}},
    "evidence_complete": {"type": "boolean"},
    "required_tests_passed": {"type": "boolean"},
    "run_id": {"type": "string", "minLength": 1},
    "resolved_finding_ids": {"type": "array", "items": {"type": "string"}},
    "finding_resolution_evidence": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
  }
}
