{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-dev/verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commands", "secret_scan"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "required", "timeout_seconds"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "required": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "secret_scan": {"type": "boolean"},
    "required_ci_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "ci_wait_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800
    }
  }
}
